<Window x:Class="LabubuView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Labubu Manager" 
        Height="600" Width="1000"
        MinHeight="400" MinWidth="700">

    <DockPanel Margin="15">
        <!-- Кнопки -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Изменить" Command="{Binding UpdateCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Группировка редкость" Command="{Binding GroupByRarityCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Группировка размер" Command="{Binding GroupBySizeCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Сброс" Command="{Binding ResetCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Дешевая" Command="{Binding ShowCheapestCommand}" Margin="5" Padding="10,5"/>
            <Button Content="Дорогая" Command="{Binding ShowMostExpensiveCommand}" Margin="5" Padding="10,5"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding Items}" 
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="120"/>
                <DataGridTextColumn Header="Редкость" Binding="{Binding Rarity}" Width="100"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price,StringFormat=C}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
